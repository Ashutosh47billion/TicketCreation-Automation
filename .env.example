# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# This tool is repo-agnostic: point it at any GitHub repo you have a PAT for.
# GitHub owner/repo/project/token can also be set live from the UI's Connect
# panel without touching this file — the values below are just a startup
# fallback. The AI API keys, however, only live here.

# AI provider for AI-assisted ticket drafting — "anthropic" or "gemini". You can
# configure both keys below and switch between them at runtime from the UI;
# this just picks which one is active on startup.
AI_PROVIDER=anthropic

# Anthropic API key (starts with sk-ant-api03-, not a session/OAuth token)
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-haiku-4-5-20251001

# Google Gemini API key (console.cloud.google.com / aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-2.0-flash

# GitHub — startup fallback only; the UI's Connect panel overrides this live.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_NAME=
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# Optional: path to a markdown file with a "Team Roaster" section (name - role,
# one per line) used as an assignee-suggestion fallback when there's no ticket
# history yet. See config/roster_domains.json to adjust which roles/labels map
# to which domain for your org.
# TEAM_ROSTER_FILE=skills/skills.md
